# 全局构建参数：Debian apt 镜像源。
# 实测本机 mirrors.aliyun.com 只有 ~25KB/s（trixie 那一层会卡几分钟到几十分钟），
# 而 mirror.nju.edu.cn 能到 ~28MB/s，故默认换成南大源。
# 换源方式：docker build --build-arg DEBIAN_MIRROR=mirrors.ustc.edu.cn ...
# （docker-compose 下可在服务的 build.args 里加 DEBIAN_MIRROR: xxx）
# 每个 stage 里必须再写一次 `ARG DEBIAN_MIRROR` 才能展开（Dockerfile 的 ARG 作用域规则）。
ARG DEBIAN_MIRROR=mirror.nju.edu.cn

# ============================ 共享 base ============================
FROM ghcr.nju.edu.cn/astral-sh/uv:python3.13-bookworm-slim AS base

# 承接文件头的全局 ARG（本层 apt 源）
ARG DEBIAN_MIRROR

# 标准 uv Docker 最佳实践环境变量
ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/cache/uv \
    UV_NO_DEV=1 \
    UV_NO_EDITABLE=1 \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    # 虚拟环境固定建在 /opt/venv，而不是 uv 默认的 /app/.venv：
    # be-bilibili-crawler 在 compose 里把整个项目目录 bind mount 到 /app，
    # /app/.venv 会被宿主机目录顶掉（宿主机 .venv 的控制台脚本 shebang 指向宿主机绝对路径，
    # 容器内 exec 直接失败），表现为 `uvicorn: executable file not found in $PATH`。
    # 放到 /app 之外后，运行期解释器与依赖不再受任何 /app 挂载影响。
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    # 三个服务各自的源码根目录，统一加入 PYTHONPATH，让控制台脚本 `uvicorn` 能找到本地包
    # （main / app）。各 target 镜像里只存在自己的源码目录，其余路径不存在会被 Python 自动忽略，无冲突。
    PYTHONPATH=/app \
    RUSTUP_UPDATE_ROOT=https://mirrors.aliyun.com/rustup/rustup \
    RUSTUP_DIST_SERVER=https://mirrors.aliyun.com/rustup

# uvicorn / python / alembic 等控制台脚本都在 /opt/venv/bin，统一前置到 PATH
ENV PATH="/opt/venv/bin:$PATH"

# 配置 Debian 镜像源（地址由 ARG DEBIAN_MIRROR 决定，默认 mirror.nju.edu.cn）
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    # 加速 apt 下载：Queue-Mode=access 允许对同一镜像源开多个并发连接（默认是 host 串行），
    # Pipeline-Depth 提高单连接内请求流水深度，Retries 避免偶发 4xx/超时直接失败。
    printf '%s\n' \
      'Acquire::Queue-Mode "access";' \
      'Acquire::http::Pipeline-Depth "5";' \
      'Acquire::Retries "3";' \
      'Acquire::http::Timeout "20";' \
      > /etc/apt/apt.conf.d/99-build-speed.conf

# rpa / message「构建阶段」共享的系统依赖。
# 实测两者依赖全部命中 manylinux wheel（psycopg2 已改为自带 libpq 的 psycopg2-binary），
# 构建期无需 C 扩展源码编译，故不再保留 g++/gcc/make/pkg-config/libssl-dev 与 nodejs/npm，
# 也不再保留 chromium 运行库（那是运行阶段才需要的，现由 rpa 运行阶段自行安装）。
# 只留 curl / git / ca-certificates，保证构建期额外的 https / git 拉取能力。
# 这些只进构建阶段——rpa / message 的运行阶段是各自独立的最小底座（见各自 target），
# 不会被继承，因此不会进入最终运行镜像（crawler 另有 crawler-base，与本层无关）。
# apt 索引与 .deb 归档交给 BuildKit cache mount 保管：以后调整本层不必重新下载，
# 且挂载内容不会提交进镜像层（因此这里不再 apt-get clean / rm -rf lists）。
# cache id 带上发行版：bookworm 与 trixie 不能共用 apt 缓存，否则两边的
# /var/lib/apt/lists 索引会互相覆盖，每次切发行版都要重新拉取索引。
RUN --mount=type=cache,id=apt-archives-bookworm,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-bookworm,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates

# ============================ crawler 专用底座（Debian 13 / glibc 2.41）============================
# crawler 不能复用共享 base（Debian 12 bookworm / glibc 2.36），原因：
# 依赖 bili_ticket_gt_python-0.3.3 的 wheel 是 maturin 打的
# Tag=cp313-cp313-linux_x86_64（**不是 manylinux**，见其 dist-info/WHEEL），
# 构建机器用的是 glibc>=2.38 的工具链，因此这个 .so 运行期需要 glibc 2.38 引入的
# __isoc23_strtol / __isoc23_strtoll / __isoc23_strtoull / __isoc23_sscanf 四个符号
# （objdump -T 可见 GLIBC_2.38 版本依赖）。
#   - Debian 12 bookworm = glibc 2.36  → ImportError: undefined symbol: __isoc23_strtoll
#   - Debian 13 trixie   = glibc 2.41  → 导入正常（已实测）
#   - 开发机 Ubuntu 24.04 = glibc 2.39 → 导入正常（所以本地跑得起来、容器起不来）
# rpa / message 仍用共享 base，不受影响。
FROM ghcr.nju.edu.cn/astral-sh/uv:python3.13-trixie-slim AS crawler-base

ARG DEBIAN_MIRROR

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/cache/uv \
    UV_NO_DEV=1 \
    UV_NO_EDITABLE=1 \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    # 虚拟环境固定建在 /opt/venv，而不是 uv 默认的 /app/.venv：
    # be-bilibili-crawler 在 compose 里把整个项目目录 bind mount 到 /app，
    # /app/.venv 会被宿主机目录顶掉（宿主机 .venv 的控制台脚本 shebang 指向宿主机绝对路径，
    # 容器内 exec 直接失败），表现为 `uvicorn: executable file not found in $PATH`。
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    PYTHONPATH=/app

# uvicorn / python / alembic 等控制台脚本都在 /opt/venv/bin，统一前置到 PATH
# /opt/node-dist/bin：Node.js 官方二进制的 node / npm（不走 apt，见下方 apt 层说明）
ENV PATH="/opt/venv/bin:/opt/node-dist/bin:$PATH"

# 配置 Debian 镜像源（地址由 ARG DEBIAN_MIRROR 决定，默认 mirror.nju.edu.cn）
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    # 加速 apt 下载：Queue-Mode=access 允许对同一镜像源开多个并发连接（默认是 host 串行），
    # Pipeline-Depth 提高单连接内请求流水深度，Retries 避免偶发 4xx/超时直接失败。
    printf '%s\n' \
      'Acquire::Queue-Mode "access";' \
      'Acquire::http::Pipeline-Depth "5";' \
      'Acquire::Retries "3";' \
      'Acquire::http::Timeout "20";' \
      > /etc/apt/apt.conf.d/99-build-speed.conf

# crawler 需要的构建工具 + chromium 运行库。
# 注意 Debian 13 的包名变化（相对 bookworm）：
#   libgl1-mesa-glx → libgl1 + libglx-mesa0 + libgl1-mesa-dri
#   libglib2.0-0    → libglib2.0-0t64（t64 过渡改名，旧名在 trixie 已无候选）
# Node.js 刻意**不**走 apt：Debian 的 npm 包会连带拉进 webpack / jest / babel 等上百个
# node-* 依赖，光下载 + dpkg 解包就要两分多钟；改用下方官方二进制（29MB，2~3 秒）。
# apt 索引与 .deb 归档交给 BuildKit cache mount 保管：以后调整本层不必重新下载，
# 且挂载内容不会提交进镜像层（因此这里不再 apt-get clean / rm -rf lists）。
# 与 bookworm 的 apt cache 分开（发行版不同，索引互不通用）
RUN --mount=type=cache,id=apt-archives-trixie,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-trixie,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    gcc \
    make \
    curl \
    xz-utils \
    pkg-config \
    libssl-dev \
    git \
    libgl1 \
    libglx-mesa0 \
    libgl1-mesa-dri \
    libglib2.0-0t64 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1

# Node.js 官方二进制（cdn.npmmirror.com 镜像）：构建期用它跑 `npm install jsdom md5`，
# 运行期 execjs 也只需要 node 二进制。换版本：--build-arg NODE_VERSION=20.18.0
ARG NODE_VERSION=22.11.0
RUN curl -fsSL "https://cdn.npmmirror.com/binaries/node/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" -o /tmp/node.tar.xz && \
    mkdir -p /opt/node-dist && \
    tar -xJf /tmp/node.tar.xz -C /opt/node-dist --strip-components=1 && \
    rm -f /tmp/node.tar.xz && \
    node -v && npm -v

# ============================ crawler 构建阶段 ============================
# 只承担「构建」：上面的编译工具链（g++ / gcc / make / pkg-config）、git、npm
# 与各类 -dev 头文件都只存在于本阶段，不会进入最终运行镜像。
FROM crawler-base AS crawler-build
WORKDIR /app

# Node 依赖仅 crawler 需要（jsdom / md5）。运行期只需要 node 二进制跑 execjs，
# npm 自身与 /root/.npm 缓存都不进运行镜像（npm install 默认还会留 ~100MB 缓存）。
# 刻意装到 /opt/node 而不是 /app/node_modules：compose 会把 ./be-bilibili-crawler 整目录
# bind mount 到 /app（对齐 be-message-service 的「改代码重启即生效」），宿主机没有 node_modules，
# 放在 /app 下会被宿主机目录顶掉 → execjs 里 require('jsdom' / 'md5') 直接失败。
# 外移后由 NODE_PATH=/opt/node_modules 兜底解析（execjs 把 JS 写到临时文件执行，靠不了 cwd）。
COPY be-bilibili-crawler/package.json /opt/node/package.json
RUN npm config set registry https://registry.npmmirror.com && \
    npm install --omit=dev --no-audit --no-fund --prefix /opt/node && \
    npm cache clean --force && \
    rm -rf /root/.npm

# bili-common 作为路径依赖，解析 ../bili-common → /bili-common（解析阶段需存在）
COPY bili-common /bili-common

# 仅安装依赖（不装项目本体）：lock + pyproject 通过 bind 挂载，源码变动不会使该层缓存失效
# 并发参数：本机 lock 有 182 个 wheel，默认并发下 overlayfs 上的 copy 安装（UV_LINK_MODE=copy）
# 会拖到 8 分钟级；提高下载 / 安装 / 缓存读取并发可明显缩短冷装时间。
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    --mount=type=bind,source=be-bilibili-crawler/uv.lock,target=uv.lock \
    --mount=type=bind,source=be-bilibili-crawler/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=be-bilibili-crawler/.python-version,target=.python-version \
    UV_CONCURRENT_DOWNLOADS=32 \
    UV_CONCURRENT_INSTALLS=8 \
    UV_CONCURRENT_CACHE_READS=8 \
    uv sync --locked --no-install-project

# 安装 chromium（仅 crawler 运行期需要，写入共享目录，运行阶段整目录 COPY 走）
# 用 patchright 自带的 CLI：运行代码只用 patchright.async_api，playwright 包已移出运行依赖；
# patchright 同样遵循 PLAYWRIGHT_BROWSERS_PATH 环境变量，浏览器仍落在 /opt/playwright-browsers。
# PLAYWRIGHT_DOWNLOAD_HOST 指向 npmmirror：官方 cdn.playwright.dev 实测约 0.3MB/s
# （177MiB 的 chrome-linux64.zip 要 ~9 分钟），换镜像后同一构建可压到 1 分钟内。
# 该变量只在本层内联生效，不写进 ENV，避免污染运行期环境与后续层缓存。
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright \
    uv run patchright install chromium

# 拷贝源码（含 pyproject.toml / uv.lock，供最终 uv sync 使用）
COPY be-bilibili-crawler/ .

# 安装项目本体（bili-common 的非 editable 安装由 UV_NO_EDITABLE 控制）
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    UV_CONCURRENT_INSTALLS=8 \
    UV_CONCURRENT_CACHE_READS=8 \
    uv sync --locked

# ============================ crawler 运行阶段 ============================
# 刻意不 FROM base：base 为构建准备的 apt 包——g++ gcc make git npm pkg-config
# libssl-dev libpq-dev 共约 640MB，外加没做 apt-get clean 残留的 ~57MB .deb 归档——
# 都不该出现在运行镜像里。这里单独铺最小运行底座，只装真正运行期需要的系统包：
# nodejs（execjs 跑 JS）+ chromium 运行库 + curl/ca-certificates。
# venv（/opt/venv）、浏览器（/opt/playwright-browsers）、node_modules、源码都从构建阶段复制。
# 必须与 crawler-base 同发行版（Debian 13 / glibc 2.41）：
#   1) bili_ticket_gt_python 的 .so 需要 glibc>=2.38（见上面 crawler-base 的说明）；
#   2) /opt/venv 的 pyvenv.cfg / shebang 指向镜像里的 python，发行版要一致，避免解释器版本漂移。
FROM ghcr.nju.edu.cn/astral-sh/uv:python3.13-trixie-slim AS crawler

ARG DEBIAN_MIRROR

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/cache/uv \
    UV_NO_DEV=1 \
    UV_NO_EDITABLE=1 \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    # 与 base 保持一致：虚拟环境在 /opt/venv，不受 compose 把项目目录 bind mount 到 /app 影响
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    # 源码根目录，让控制台脚本 `uvicorn` 能找到本地包（main / app）。
    # /bili-common：compose 把仓库的 bili-common 挂到这里，PYTHONPATH 优先于 site-packages，
    # 于是公共包改动也能靠「重启容器」生效；不挂载时该目录不存在，Python 自动忽略，
    # 回落到 venv 里构建期装好的非 editable 副本。
    PYTHONPATH=/app:/bili-common \
    # execjs 的 JS 由 node 在临时文件里执行，require('jsdom' / 'md5') 靠不了 cwd，
    # 只能走 NODE_PATH 兜底（node_modules 已外移到 /opt，见 crawler-build 的说明）
    NODE_PATH=/opt/node_modules

# uvicorn / python / alembic 等控制台脚本都在 /opt/venv/bin，统一前置到 PATH
# /opt/node-dist/bin：node 官方二进制，从 crawler-build 直接 COPY 过来（不再走 apt 装 nodejs）
ENV PATH="/opt/venv/bin:/opt/node-dist/bin:$PATH"

# 配置 Debian 镜像源（地址由 ARG DEBIAN_MIRROR 决定，默认 mirror.nju.edu.cn）
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    # 加速 apt 下载：Queue-Mode=access 允许对同一镜像源开多个并发连接（默认是 host 串行），
    # Pipeline-Depth 提高单连接内请求流水深度，Retries 避免偶发 4xx/超时直接失败。
    printf '%s\n' \
      'Acquire::Queue-Mode "access";' \
      'Acquire::http::Pipeline-Depth "5";' \
      'Acquire::Retries "3";' \
      'Acquire::http::Timeout "20";' \
      > /etc/apt/apt.conf.d/99-build-speed.conf

# 只装运行期系统依赖：lib*-dev 头文件与编译工具一律不装
# （Debian 13 包名：libglib2.0-0t64 / libssl3t64；libgl1-mesa-glx 改为 libgl1 + libglx-mesa0 + libgl1-mesa-dri）
# apt 索引与 .deb 交给 BuildKit cache mount 保管：以后调整本层不必重新下载。
# 因此这里**不再**执行 apt-get clean / rm -rf /var/lib/apt/lists（那会清空缓存，
# 且挂载内容不会提交进镜像层，索引本来也不会留在镜像里）。
RUN --mount=type=cache,id=apt-archives-trixie,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-trixie,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0t64 \
    libgl1 \
    libglx-mesa0 \
    libgl1-mesa-dri \
    libglu1-mesa \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libssl3t64 \
    ca-certificates \
    curl

WORKDIR /app

COPY --from=crawler-build /opt/venv /opt/venv
COPY --from=crawler-build /opt/playwright-browsers /opt/playwright-browsers
# node_modules 刻意放在 /app 之外：compose 会把 ./be-bilibili-crawler bind mount 到 /app，
# /app/node_modules 会被宿主机目录顶掉。运行期由 NODE_PATH=/opt/node_modules 解析。
COPY --from=crawler-build /opt/node/node_modules /opt/node_modules
# node 二进制（含 npm）直接从构建阶段取，运行镜像不必再 apt 装 nodejs
COPY --from=crawler-build /opt/node-dist /opt/node-dist
# 镜像自带一份源码作兜底（与 message 阶段 COPY app 包的意图一致）；
# compose 挂载 ./be-bilibili-crawler:/app 后被覆盖，改代码重启容器即可生效。
COPY --from=crawler-build /app /app

EXPOSE 23333
# 依赖由构建期 `uv sync --locked` 固定进镜像的 /opt/venv，运行期无需再同步依赖（启动不依赖网络）。
# 源码由 compose 的 bind mount 覆盖（./be-bilibili-crawler:/app），改代码 → docker compose restart
# 即生效；只有 uv.lock / pyproject.toml 变了才需要重建镜像（develop.watch 的 rebuild 规则）。
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "23333"]

# ============================ rpa 构建阶段 ============================
# 与 crawler/message 一致做「构建 / 运行」分离：编译器与 nodejs/npm 只留在本阶段。
# RPA-Browser 已提交 uv.lock，故改用与 crawler/message 相同的 --locked 两阶段写法
# （不再在构建期执行 `uv lock`，构建结果完全由仓库内的 lock 决定）。
FROM base AS rpa-build
WORKDIR /app

# bili-common 作为路径依赖，解析 ../bili-common → /bili-common。
# 注意：--no-install-project 只是不装 rpa-browser 本体，路径依赖 bili-common 仍会被
# 构建并安装，所以这里必须放完整源码。
COPY bili-common /bili-common

# 仅安装依赖（不装项目本体）：lock + pyproject + .python-version 通过 bind 挂载
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    --mount=type=bind,source=RPA-Browser/uv.lock,target=uv.lock \
    --mount=type=bind,source=RPA-Browser/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=RPA-Browser/.python-version,target=.python-version \
    uv sync --locked --no-install-project

# 复制项目文件（含 pyproject.toml / uv.lock，供最终 uv sync 使用）
COPY RPA-Browser/ .

# 安装项目本体（bili-common 的非 editable 安装由 UV_NO_EDITABLE 控制）
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    uv sync --locked

# ============================ rpa 运行阶段 ============================
# 刻意不 FROM base：base 为构建准备的 g++ gcc make git pkg-config libssl-dev
# 与 crawler 的 nodejs/npm 都不该进运行镜像。
# 这里只装运行期真正需要的系统库：patchright 下载的 chromium 运行库 + onnxruntime 的 libgomp1。
# 必须与 base 同发行版（Debian 12 bookworm）：/opt/venv 的 pyvenv.cfg / shebang 指向镜像里的
# python，发行版一致才能避免解释器版本漂移。
FROM ghcr.nju.edu.cn/astral-sh/uv:python3.13-bookworm-slim AS rpa

ARG DEBIAN_MIRROR

ENV PYTHONUNBUFFERED=1 \
    # 与构建阶段保持一致：潜在的任何运行期 uv 调用都不会在 /app 下另建 .venv
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app

# uvicorn / python / alembic 等控制台脚本都在 /opt/venv/bin，统一前置到 PATH
ENV PATH="/opt/venv/bin:$PATH"

# 配置 Debian 镜像源（地址由 ARG DEBIAN_MIRROR 决定，默认 mirror.nju.edu.cn）
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    # 加速 apt 下载：Queue-Mode=access 允许对同一镜像源开多个并发连接（默认是 host 串行），
    # Pipeline-Depth 提高单连接内请求流水深度，Retries 避免偶发 4xx/超时直接失败。
    printf '%s\n' \
      'Acquire::Queue-Mode "access";' \
      'Acquire::http::Pipeline-Depth "5";' \
      'Acquire::Retries "3";' \
      'Acquire::http::Timeout "20";' \
      > /etc/apt/apt.conf.d/99-build-speed.conf

# chromium 运行库（现状 base 提供的 libgl*/libglib/libsm/libxext/libxrender/libgomp 运行期对应物）
# + patchright/chromium 还需要的 nss/atk/cups/drm/gbm/pango/cairo/asound/atspi 等
# + git/curl/ca-certificates：modelscope/HF 拉取模型与 https 访问所需（与 base 现状能力对齐）
RUN --mount=type=cache,id=apt-archives-bookworm,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-bookworm,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    git \
    curl \
    ca-certificates

WORKDIR /app

COPY --from=rpa-build /opt/venv /opt/venv
# 镜像自带一份源码作兜底；compose 挂载 ./RPA-Browser/app:/app/app 后被覆盖，
# 改代码重启容器即可生效。
COPY --from=rpa-build /app /app

EXPOSE 28000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "28000"]

# ============================ message 构建阶段 ============================
# 与 crawler 一样做「构建 / 运行」分离：base 里为 crawler/rpa 准备的编译工具链
# （g++ gcc make git pkg-config libssl-dev libpq-dev）、nodejs/npm，以及 rpa 的 OpenCV
# 运行库，都只留在本阶段，不会进入最终运行镜像。
FROM base AS message-build
WORKDIR /app

# bili-common 作为路径依赖，解析 ../bili-common → /bili-common。
# 注意：--no-install-project 只是不装 message-service 本体，路径依赖 bili-common
# 仍会被构建并安装，所以这里必须放完整源码，不能只 COPY 其 pyproject.toml。
COPY bili-common /bili-common

# 仅安装依赖（不装项目本体）：lock + pyproject + .python-version 通过 bind 挂载，
# 源码变动不会使该层缓存失效（.python-version 与 crawler/rpa 保持一致，避免解释器漂移）。
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    --mount=type=bind,source=be-message-service/uv.lock,target=uv.lock \
    --mount=type=bind,source=be-message-service/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=be-message-service/.python-version,target=.python-version \
    uv sync --locked --no-install-project

# 拷贝源码与清单（pyproject.toml / uv.lock / README.md 供最终 uv sync 使用）
COPY be-message-service/pyproject.toml ./pyproject.toml
COPY be-message-service/uv.lock ./uv.lock
COPY be-message-service/README.md ./README.md
# app 包整体落到 /app/app：与运行期 volume 挂载点（./be-message-service/app:/app/app）一致。
# 旧写法 `COPY ... ./` 会把包内容铺平到 /app，形成「/app 一份、/app/app 一份」的双代码树：
# uvicorn main:app 加载的是镜像内的 /app/main.py，改 main.py 必须重建镜像才生效。
COPY be-message-service/app ./app

# 安装项目本体（bili-common 的非 editable 安装由 UV_NO_EDITABLE 控制）
RUN --mount=type=cache,id=uv-cache,target=/cache/uv \
    uv sync --locked

# ============================ message 运行阶段 ============================
# 刻意不 FROM base：base 的编译工具链（g++ gcc make git pkg-config libssl-dev libpq-dev）、
# crawler 的 nodejs/npm、rpa 的 OpenCV 运行库都只为构建服务，不该出现在运行镜像里。
# 这里只铺最小运行底座：
#   ca-certificates → httpx 走 https 调用 Casdoor / 推送渠道
# psycopg2 已改用 psycopg2-binary（manylinux wheel 自带 libpq），运行期不再需要系统 libpq5。
# healthcheck 用 python urllib 探活，故不需要 curl。
# 必须与 base 同发行版（Debian 12 bookworm）：/opt/venv 的 pyvenv.cfg / shebang 指向
# 镜像里的 python，发行版一致才能避免解释器版本漂移。
FROM ghcr.nju.edu.cn/astral-sh/uv:python3.13-bookworm-slim AS message

ARG DEBIAN_MIRROR

ENV PYTHONUNBUFFERED=1 \
    # 与构建阶段保持一致：潜在的任何运行期 uv 调用都不会在 /app 下另建 .venv
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app

# uvicorn / python / alembic 等控制台脚本都在 /opt/venv/bin，统一前置到 PATH
ENV PATH="/opt/venv/bin:$PATH"

# 配置 Debian 镜像源（地址由 ARG DEBIAN_MIRROR 决定，默认 mirror.nju.edu.cn）
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && \
    # 加速 apt 下载：Queue-Mode=access 允许对同一镜像源开多个并发连接（默认是 host 串行），
    # Pipeline-Depth 提高单连接内请求流水深度，Retries 避免偶发 4xx/超时直接失败。
    printf '%s\n' \
      'Acquire::Queue-Mode "access";' \
      'Acquire::http::Pipeline-Depth "5";' \
      'Acquire::Retries "3";' \
      'Acquire::http::Timeout "20";' \
      > /etc/apt/apt.conf.d/99-build-speed.conf

# 只装运行期系统依赖；apt 索引与 .deb 交给 BuildKit cache mount 保管，不提交进镜像层
RUN --mount=type=cache,id=apt-archives-bookworm,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-bookworm,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates

WORKDIR /app

COPY --from=message-build /opt/venv /opt/venv
# 镜像自带一份源码作兜底；compose 挂载 ./be-message-service/app:/app/app 后被覆盖，
# 改代码重启容器即可生效。
COPY --from=message-build /app /app

EXPOSE 18739
# 入口必须是 app.main（= /app/app/main.py）：与挂载的源码同一个文件，
# 改路由 / 生命周期钩子后无需重建镜像，重启容器即可生效。
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "18739"]

# ============================ default (meta-target) ============================
# docker-compose 总是通过 --target 构建具体服务（crawler / rpa / message）。
# 本阶段仅用于建立构建依赖图，消除 "unreachable stage" 警告；
# 实际运行镜像由各 --target 独立产出，本阶段不会被 docker-compose 使用。
FROM base AS default
COPY --from=crawler /usr/local/bin/uv /tmp/.dep-crawler
COPY --from=rpa /usr/local/bin/uv /tmp/.dep-rpa
COPY --from=message /usr/local/bin/uv /tmp/.dep-message
RUN rm -rf /tmp/.dep-*
CMD ["echo", "Use: docker compose up <service>  (--target is set automatically)"]
