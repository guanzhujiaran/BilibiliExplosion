[mysqld]
# ---------------------------------------------------------
# 1. 关闭 Binlog (二进制日志)
# ---------------------------------------------------------
# 方法 A: 在参数前加 '#' 注释掉原有的 log-bin 行 (推荐)
# log-bin = mysql-bin

# 方法 B: 显式添加 skip-log-bin 参数 (MySQL 5.7+ / 8.0+)
skip-log-bin

# 如果存在 server-id 配置，且不需要主从复制，建议也注释掉
# server-id = 1

# ---------------------------------------------------------
# 2. 关闭常规日志打印
# ---------------------------------------------------------

# 关闭通用查询日志 (记录所有连接和执行的 SQL)
general_log = 0
general_log_file = /var/log/mysql/mysql.log

# 关闭慢查询日志 (记录执行超过阈值的 SQL)
slow_query_log = 0
slow_query_log_file = /var/log/mysql/mysql-slow.log


# MySQL 8.0+ 默认使用 json 格式打印错误日志，信息量大但占空间
log_error_verbosity = 1

# ---------------------------------------------------------
# 3. 连接和超时优化 (解决 Lost connection 问题)
# ---------------------------------------------------------

# 等待超时时间 (秒)，客户端无操作多久后断开连接
# 设置为 8 小时 (28800 秒),与 Docker Compose 中的配置一致
wait_timeout = 28800
interactive_timeout = 28800

# TCP 连接超时时间 (秒),防止网络波动导致的连接挂起
connect_timeout = 10

# 允许的最大连接数
max_connections = 500

# 线程缓存大小，减少线程创建开销
thread_cache_size = 100

# 每个连接的内存缓冲区大小 (字节)
# 适当增大可以减少 IO 操作，提升性能
net_buffer_length = 32768
max_allowed_packet = 64M

# ---------------------------------------------------------
# 4. 连接保活配置 (防止连接被提前回收)
# ---------------------------------------------------------

# 客户端空闲多久后发送 ping (秒),保持连接活跃
# 设置为 600 秒 (10 分钟),小于 wait_timeout
idle_time = 600

# 是否启用 TCP keepalive
tcp_keepalive = 1

# ---------------------------------------------------------
# 5. InnoDB 引擎优化
# ---------------------------------------------------------

# InnoDB 缓冲池大小，根据内存调整 (建议物理内存的 50-70%)
innodb_buffer_pool_size = 256M

# InnoDB 日志文件大小
innodb_log_file_size = 64M

# InnoDB 刷新日志方式，1 最安全但性能较低
innodb_flush_log_at_trx_commit = 2

# InnoDB 锁等待超时时间 (秒)
innodb_lock_wait_timeout = 50

# ---------------------------------------------------------
# 6. 字符集配置
# ---------------------------------------------------------

# 服务器默认字符集
character-set-server = utf8mb4

# 服务器默认排序规则
collation-server = utf8mb4_unicode_ci

# 客户端默认字符集
default-character-set = utf8mb4

# 连接默认字符集
init_connect = 'SET NAMES utf8mb4'
