MYSQL_PORT=10000
REDIS_PORT=10001
RABBITMQ_PORT=5672
RABBITMQ_WEBUI_PORT=15672
POSTGRES_PORT=10004
FASTAPI_PORT=10005
UNIDBG_PORT=10006
NODEJS_PPTR_PORT=10007
NODEJS_PPTR_DEV_PORT=10008
LMSTUDIO_PORT=10009
MILVUS_PORT=19530


MYSQL_PASSWORD=114514
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=114514
POSTGRES_USER=postgres
POSTGRES_PASSWORD=114514
PROXY_SERVER=http://host.docker.internal:3128
V2RAY_HOST=host.docker.internal

NGINX_PORT=80
NGINX_SSL_PORT=443

PUSHME_TOKEN=<PUSHME_TOKEN>
PUSHPLUS_TOKEN=<PUSHPLUS_TOKEN>

ENV_TZ=Asia/Shanghai

SITE_LOG_DIR=# 站点nginx日志的目录
SITE_REPORT_DIR=# 存放生成站点html的目录
SITE_CERT_DIR=# 站点证书的目录

FASTAPI_SHOW_LOG=1

# 开发环境配置: 0=生产环境(启动定时任务), 1=开发环境(不启动定时任务)
IS_DEV=0

# Casdoor配置
CASDOOR_PORT=10011
RPA_BROWSER_PORT=10012
CASDOOR_CLIENT_ID=xxxx
CASDOOR_CLIENT_SECRET=xxxxxxx
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=app-built-in
CASDOOR_REDIRECT_URI=http://xxxxxx/api/v1/casdoor/callback
CASDOOR_CERTIFICATE=-----BEGIN CERTIFICATE-----xxxxxx-----END CERTIFICATE-----

Ollama_PORT=10013

# 外部 LLM API 列表（按顺序优先使用，全部失败后回退到本地 Ollama）
# JSON 格式，例如：llm_apis='[{"base_url":"https://...","model_name":"gpt-3.5","token":"sk-xxx"}]'
# 或用双下划线：llm_apis__0__base_url=https://...  llm_apis__0__model_name=gpt-3.5  llm_apis__0__token=sk-xxx
llm_apis=[]