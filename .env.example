# 本文件变量均对应 docker-compose.yml 通过 ${VAR} 引用的环境变量；新增服务变量需同步更新 docker-compose.yml
#
# 编排里对三类变量用了三种写法，对应三种「漏配」行为：
#
# ① ${VAR:-默认值} —— 带默认值，**整行可以删掉**（空值也走默认值，不会把空串塞进容器）：
#    - 容器间访问地址：POSTGRES_HOST / BILI_CRAWLER_URI / BILI_CRAWLER_QUERY_URI /
#      RPA_SERVICE_URI / MESSAGE_SERVICE_URI / CASDOOR_ENDPOINT（默认值 = compose 服务名 + 容器端口）
#    - CRAWLER_QUERY_MYSQL_* / CRAWLER_QUERY_REDIS_*（默认指向本编排的 mysql / redis）
#    - 运行参数：ENV_TZ（默认 Asia/Shanghai）/ FASTAPI_SHOW_LOG / LOG_LEVEL /
#      IS_DEV / llm_apis / FASTAPI_QUERY_PORT / FASTAPI_CRAWLER_PORT / GO_PROXY_* /
#      NET_IF（宿主机网卡名，见文件底部说明）等
#
# ② ${VAR:?提示} —— **必须给值**，漏配时 compose 直接中止并逐条打印
#    「required variable XXX is missing a value: 请在 .env 里设置 ...」，不会带着空值启动：
#    - 账号密码：MYSQL_PASSWORD / RABBITMQ_USER / RABBITMQ_PASSWORD /
#      POSTGRES_USER / POSTGRES_PASSWORD
#    - Casdoor 登录应用：CASDOOR_CLIENT_ID / CLIENT_SECRET / ORGANIZATION /
#      APPLICATION / REDIRECT_URI / CERTIFICATE
#    - Casdoor 管理员应用（app-built-in）：CASDOOR_ADMIN_NAME / PASSWORD /
#      CLIENT_ID / CLIENT_SECRET
#    - 推送渠道：MESSAGE_CONFIG（空串会让各服务 pydantic 校验失败）
#    - 宿主机映射端口：MYSQL_PORT / REDIS_PORT / RABBITMQ_PORT / RABBITMQ_WEBUI_PORT /
#      POSTGRES_PORT / FASTAPI_PORT / UNIDBG_PORT / NODEJS_PPTR_PORT / LLAMA_PORT /
#      MILVUS_PORT / MESSAGE_SERVICE_PORT / CASDOOR_PORT / RPA_BROWSER_PORT
#      （不给默认值＝不用随机端口，避免「容器起来了但前端连不上」这种静默故障）
#
# ③ 明确可以留空（编排里就是裸 ${VAR}，空值有代码兜底）：
#    - SERVER_NAME / SERVER_ADDRESS：空值时分别回落「各服务内置服务名」/ 容器 hostname
#    - PROXY_SERVER / V2RAY_HOST：空值＝不走该代理
MYSQL_PORT=10000
REDIS_HOST=redis
REDIS_PORT=10001
RABBITMQ_PORT=5672
RABBITMQ_WEBUI_PORT=15672
POSTGRES_PORT=10004
FASTAPI_PORT=10005
# 查询服务（crawler-query target）对外端口；服务内部固定监听 23336
FASTAPI_QUERY_PORT=23336
# 爬虫容器（与生产同一角色，仅 dev 编排用 IS_DEV=1 关掉定时任务）对外端口；容器内固定监听 23333
FASTAPI_CRAWLER_PORT=23333
# ===== 查询服务（crawler-query 容器）独立的连接参数 =====
# 只影响 be-bilibili-crawler-query；爬虫容器仍用上面的 MYSQL_* / REDIS_*，互不干扰。
# 想让查询服务直连生产库时改这一组：
#   HOST=生产地址、USER=只读账号（如 bili_ro）、PASSWORD=该账号密码、
#   REDIS 也一起指生产（直播抽奖数据 all_live_lot 只存在于 Redis，不在 MySQL）。
# 注意这里是容器内视角：MySQL 用 3306、Redis 用 6379，不是宿主机映射的 10000 / 10001。
CRAWLER_QUERY_MYSQL_HOST=mysql
CRAWLER_QUERY_MYSQL_PORT=3306
CRAWLER_QUERY_MYSQL_USER=root
CRAWLER_QUERY_MYSQL_PASSWORD=114514
CRAWLER_QUERY_REDIS_HOST=redis
CRAWLER_QUERY_REDIS_PORT=6379
CRAWLER_QUERY_REDIS_PWD=
UNIDBG_PORT=10006
NODEJS_PPTR_PORT=10007
LLAMA_PORT=10009
MILVUS_PORT=19530
MYSQL_PASSWORD=114514
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=114514
# 容器间访问：Postgres 在容器网内固定走服务名 postgres（编排已给默认值，可省略）
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=114514
PROXY_SERVER=http://host.docker.internal:3128
V2RAY_HOST=host.docker.internal

# 宿主机网卡名（可选）：IPv6 代理池（go-proxy-server）从这块网卡的公网 IPv6 /64 前缀里随机生成源地址拨号。
# 每台机器网卡名不一样（eth0 / enp3s0 / ens18 / eno1 …），但一般**不用填**：
# 容器里的程序会自己判断 —— 默认 IPv6 路由的网卡 → 带公网 IPv6 的物理网卡 → 默认 IPv4 路由的网卡
# （lo / docker* / br-* / veth* 等虚拟网卡一律排除），启动日志会打印「自动探测到出口网卡：xxx」。
# 只有多块物理网卡、想让代理固定走某一块时才填；填了且本机存在就优先用。
# 查法：`ip -6 route show default`，`dev` 后面那个名字。
NET_IF=



# 容器时区；编排里默认 Asia/Shanghai，可省略
ENV_TZ=Asia/Shanghai

# SHOW_LOG=1 打印 uvicorn 访问日志；编排默认 0
FASTAPI_SHOW_LOG=0

# 业务日志等级（loguru，be-bilibili-crawler 在 SHOW_LOG=0 时生效）：
# DEBUG / INFO / WARNING / ERROR，越小越啰嗦；默认只留告警与错误，
# 需要看轮次 / 阶段等业务节点时临时改成 INFO。
LOG_LEVEL=WARNING

# 开发环境配置: 0=生产环境(启动定时任务), 1=开发环境(不启动定时任务)
IS_DEV=1

# be-message-service 监听端口（仅它自己使用；be-bilibili-crawler 自 2.70.1 起不再依赖 / 探活它，
# 告警推送走 RabbitMQ 弱耦合）
MESSAGE_SERVICE_PORT=10013
# Casdoor配置
CASDOOR_PORT=10011
RPA_BROWSER_PORT=10012
CASDOOR_CLIENT_ID=xxx
CASDOOR_CLIENT_SECRET=xxx
CASDOOR_ORGANIZATION=xxx
CASDOOR_APPLICATION=xxx
CASDOOR_REDIRECT_URI=http://gateway:9923/api/v1/casdoor/callback
CASDOOR_CERTIFICATE=-----BEGIN CERTIFICATE-----\nxxx\n-----END CERTIFICATE-----
# Casdoor 管理员账号（password grant 换 admin token 查询用户信息；Casdoor 开启「不公开账户信息」时必须）
# 管理员登录走内置 application「app-built-in」，其 clientId/clientSecret 与普通登录应用不同，需单独配置
CASDOOR_ADMIN_NAME=xxx
CASDOOR_ADMIN_PASSWORD=xxx
CASDOOR_ADMIN_CLIENT_ID=xxx
CASDOOR_ADMIN_CLIENT_SECRET=xxx


llm_apis=[]


# 推送告警标题中的「本服务标识」：格式为 [服务名@部署地址/IP]
# SERVER_NAME 缺省使用各服务内置默认值（crawler=rpa-browser 各自不同）；SERVER_ADDRESS 缺省自动取容器 hostname
# 多实例部署时建议为每台机器设置不同的 SERVER_ADDRESS（IP 或域名），便于定位报错来源
# crawler 与 rpa-browser 共用同一组环境变量，无需分开设置
SERVER_NAME=
SERVER_ADDRESS=

MESSAGE_CONFIG='{"pushme_key":"xxx","pushme_url":"https://push.i-i.me","push_plus_token":"xxx","push_plus_url":"http://www.pushplus.plus/send","smtp_server":"smtp.163.com:465","smtp_ssl":"true","smtp_email":"xxx@163.com","smtp_password":"xxx","smtp_name":"backend_message_service","tg_bot_token":"","tg_user_id":"","tg_api_host":"","tg_proxy_host":"","tg_proxy_port":""}'

# 推送聚合（be-message-service 消费 message.push 时治理失败告警，见 push_aggregator.py）
# 只聚合失败主题（[f]）的推送；同一个 push key（接收人）只设一个桶，标题不参与分桶，
# 因此一次故障产生的多类告警会合并成一条摘要。改完需重启 be-message-service 生效。
# 冷却期（秒，下限 1）：同一 push key 在该窗口内的后续告警并入摘要；默认 60
PUSH_AGGREGATE_COOLDOWN_SECONDS=60
# 摘要正文硬上限（字符，下限 200）：超出按出现次数降序截断并提示省略条数
PUSH_AGGREGATE_MAX_LEN=1800
# 到期桶扫描间隔（秒，下限 0.5）：决定摘要最多比冷却到期晚多久发出
PUSH_AGGREGATE_SWEEP_SECONDS=2

# 以下五个容器间地址的示例值与 docker-compose.yml 的 ${VAR:-...} 默认值一致；
# 只有「网关不在同一套编排里 / 服务跑在别的机器上」时才需要覆盖：
BILI_CRAWLER_URI=http://be-bilibili-crawler:23333
# 只读查询服务（crawler-query target）：默认指向本编排的 be-bilibili-crawler-query:23336，
# 与 be-message-service 的 CRAWLER_QUERY_BASE_URL 一致；写在这里的值会覆盖编排默认值。
BILI_CRAWLER_QUERY_URI=http://be-bilibili-crawler-query:23336
RPA_SERVICE_URI=http://rpa-browser:28000
MESSAGE_SERVICE_URI=http://be-message-service:18739
CASDOOR_ENDPOINT=http://casdoor:8000


# =============================================================================
# RPA-Browser（fastapi-rpa-browser）容器内需要的全部变量
# -----------------------------------------------------------------------------
# RPA 镜像**不含** .env.dev / .env.prod（见 RPA-Browser/.dockerignore），容器只认
# docker-compose.yml 的 rpa-browser.environment —— 那里已按 app/config.py 的 Settings
# 字段逐项写成 ${VAR:-默认值}，默认值 = 代码默认值。想改哪一项就把同名变量写到这里；
# 不写即用默认值，置空也回落默认值（不会把空串塞进 int / bool 字段）。
# 本节只列常用项，视频档位 / 内存排队等参数见 compose 里对应分组的注释。
# =============================================================================

# 运行模式：prod（容器默认）/ dev。dev 会挂 MCP、把日志级别降为 INFO
RUNNING_MODE=prod
# 业务日志级别：DEBUG / INFO / WARNING / ERROR（与 crawler / message 共用）
LOG_LEVEL=WARNING
# 时区（签到 / 日统计的自然日判定）
APP_TIMEZONE=Asia/Shanghai
# 服主 / 管理员 mid（逗号分隔）：用户提交报错后实时推送的目标；空 = 只落库不推送
FEEDBACK_NOTIFY_MIDS=
# be-message 服务地址（管理员身份判定）
MESSAGE_SERVICE_URL=http://be-message-service:18739

# ---- 浏览器 ----
# 有头模式 + Xvfb 虚拟屏幕；容器内没有物理显示器，必须保持开启
XVFB_ENABLED=true
XVFB_DISPLAY=:99
XVFB_SCREEN=1920x1080x24
# 同时存在的浏览器实例上限（0 = 只按内存限制）与内存红线（%）
BROWSER_MAX_CONCURRENT_INSTANCES=0
BROWSER_LAUNCH_MAX_MEMORY_PERCENT=90.0
BROWSER_LAUNCH_MIN_AVAILABLE_MEMORY_MB=1024
# 单会话最大观看者数（0 = 不限制；每多一人多编码一份 H264，吃 CPU）
BROWSER_WEBRTC_MAX_VIEWERS=0
# 未配置代理时的出口兜底（留空 = 不注入，走代码默认）；代理绕过列表（逗号分隔 host）
PROXY_SERVER_URL=http://host.docker.internal:10809
BROWSER_PROXY_BYPASS=
# 拉取 chromium 的 GitHub 加速镜像（JSON 数组）；不写 = 用代码内置长列表
# GITHUB_PROXY_URLS=["http://127.0.0.1:7890","https://gh-proxy.com/"]
GEMINI_API_KEY=1234-2234-3234-4234

# ---- 雪花 ID worker（多实例部署必须互不相同，且与 message 的 uid/moment/topic 错开）----
BROWSER_ID_WORKER_ID=4
ACTION_ID_WORKER_ID=5
WORKFLOW_ID_WORKER_ID=6

# ---- 工作流（只列最常调的几项，其余见 compose）----
WORKFLOW_RESUME_ON_STARTUP=true
WORKFLOW_RELEASE_BROWSER_AFTER_RUN=false
WORKFLOW_QUEUE_TIMEOUT_SECONDS=1800
REQUIRE_APPROVAL_ENABLED=false
REQUIRE_PUBLISH_APPROVAL_ENABLED=true

# ---- MCP 端点（app/mcp/config.py，前缀 RPA_MCP_）----
# 容器按 prod 处理：不设置 = 关闭；需要打开时设 true
RPA_MCP_ENABLED=false
RPA_MCP_MOUNT_SUFFIX=/mcp
RPA_MCP_POLL_INTERVAL=1.5
RPA_MCP_MAX_WAIT_SECONDS=300
RPA_MCP_PAYLOAD_MAX_CHARS=1200
RPA_MCP_EXCLUDE_OPERATIONS=


# =============================================================================
# be-message-service 补充项
# -----------------------------------------------------------------------------
# 该容器挂载了 ./be-message-service/app（含宿主机 app/.env），env_file 的开发值会被
# 读进来，因此 compose 里对「会随环境变」的键逐项显式覆盖。下面这些是常改的：
# =============================================================================

# 运行环境：production（容器默认）/ development（development 才额外落日志文件）
APP_ENV=production
# FastStream（RabbitMQ 框架）自身日志级别
FASTSTREAM_LOG_LEVEL=WARNING
# 雪花 ID worker（多实例部署必须互不相同；sequence_bits 仅清库重建时可调）
MSGKEY_WORKER_ID=1
UID_WORKER_ID=1
MOMENT_ID_WORKER_ID=2
TOPIC_ID_WORKER_ID=3
# JWT 必须与网关 / pptr 侧一致，不一致表现为「登录成功但立刻 401」
JWT_SECRET=关注永雏塔菲喵，关注永雏塔菲谢谢喵！114514
JWT_EXPIRES_SECONDS=1296000
# 前端地址（Casdoor 回调缺省跳转目标）
FRONTEND_URL=
CASDOOR_SERVICE=
# 内容发布每日上限（0 = 不限制）
COMMENT_DAILY_CREATE_LIMIT=100
MOMENT_DAILY_CREATE_LIMIT=30
TOPIC_DAILY_CREATE_LIMIT=10


# =============================================================================
# gateway 补充项
# =============================================================================
# 留空 = 不设置（Express 视为 development，JWT Cookie 不带 Secure）。
# 生产走 HTTPS 时设 NODE_ENV=production 或 JWT_COOKIE_SECURE=true；
# 反过来对纯 HTTP 部署设 true 会让浏览器丢弃 cookie（登录后立刻 401）。
NODE_ENV=
JWT_COOKIE_SECURE=
REDIS_DB=0
# Casdoor 回调允许跳转的前端来源白名单（逗号分隔）；空 = 不限制
# （CASDOOR_SERVICE / FRONTEND_URL 见上面 be-message-service 段，两服务共用同名变量）
CASDOOR_FRONTEND_ALLOWLIST=


# =============================================================================
# 基础设施凭据补充项
# =============================================================================

# Redis 密码：本编排的 redis 未开 requirepass，留空即可；
# 指向「有密码的外部 Redis」时（如查询服务直连生产）填这里
CRAWLER_REDIS_PWD=
# =============================================================================
# 爬虫「开始 / 结束」推送开关（默认全关）
# =============================================================================
# 值为逗号分隔的 crawler_name（与 BackgroundServiceName 枚举值一致），
# 支持 * / all 表示全部爬虫；留空 = 不推送。
# 例：只给第三方抽奖和动态详情爬虫推开始 / 结束
#   CRAWLER_PUSH_START=GET_OTHERS_LOT_DYN,GET_DYN
#   CRAWLER_PUSH_END=GET_OTHERS_LOT_DYN,GET_DYN
CRAWLER_PUSH_START=
CRAWLER_PUSH_END=
